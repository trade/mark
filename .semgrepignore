# .semgrepignore — MARK Protocol
# Exclude from semgrep scans

# Build artifacts
node_modules/
dist/
out/
cache/
broadcast/
build/
coverage/
.venv/
*.zkey
*.ptau
*.wtns

# Vendored deps — we don't fix bugs in these
lib/
contracts/lib/

# Test files — semgrep allows bad patterns in tests by design
test/
**/test/**
**/*.test.ts
**/*.test.sol
**/script/**
circuits/scripts/

# Generated code
contracts/src/pool/verifier/
contracts/src/crypto/generated/
circuits/build/

# Docs
*.md
docs/

# Lockfiles — semgrep has special rules for these
pnpm-lock.yaml
uv.lock
package-lock.json

# Env files
.env
.env.*